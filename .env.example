# Inkling-2-Small-EXL3-4bpw-4x-DGX-Spark configuration. Copy to .env.
NODES="192.168.1.121 192.168.1.122 192.168.1.123 192.168.1.18"
FABRIC_ADDRS="10.100.10.1 10.100.10.2 10.100.10.3 10.100.10.4"   # rail-0 address per rank on the RoCE switch (fetch fan-out, TP rendezvous)
SSH_USER=spark
BASE_DIR=/home/spark/inkling-2-small-exl3-4bpw-4x-dgx-spark      # per node: bin/ (engine), logs/ (rank<R>.log, memguard-rank<R>.*), run/
MODELS_DIR=/home/spark/models
HF_BIN=/home/spark/venvs/hf/bin/hf
CACHE_DIR=/home/spark/.cache/inkling-2-small-exl3-4bpw-4x-dgx-spark
CONTAINER=inkling-2-small-exl3-4bpw-4x-dgx-spark
SERVED_NAME=inkling-2-small-exl3-4bpw-4x-dgx-spark
PORT=8000                          # rank 0's HTTP API (every rank gets the same --host/--port; rank 0 alone serves)
API_KEY=                           # the engine has no API key; the bench tools send it as a bearer token when set
PROFILE=bootstrap

# ── serving (./inkling2.sh print-serve shows the resulting command line of every rank) ───────────────────────────
TP_PORT=29571                      # rank 0's TP rendezvous on its rail-0 address (--tp-peer)
MAX_MODEL_LEN=1048576              # --max-model-len
SLOTS=4                            # --slots (concurrent sequences)
KV_TOKENS=                         # --kv-tokens: the int8 KV pool in tokens; empty: SLOTS x MAX_MODEL_LEN (every lane full)
PREFILL_CHUNK=4096                 # --prefill-chunk
SPEC=dspark                        # --spec: dspark (the pack's DSpark drafter), copy (copy drafter), auto (the arbiter
                                   # picks among the drafters the family offers) or none (serial); replies are the same bytes
PREFIX_CACHE=on                    # on: --prefix-cache on (the cache is required); off: --prefix-cache off; auto: no flag
                                   # (the engine's default, on only when the KV plan leaves memory spare); a whole number:
                                   # --prefix-cache-mib N (N MiB carved out before the KV pool; 0 disables)
VISION=on                          # on: rank 0 loads the vision tower and serves image parts; off: --no-vision on every rank
                                   # (a follower never loads a tower either way; every rank's flags stay identical)
MEMORY_FLOOR_GIB=                  # the engine's MemAvailable floor at boot, GiB >= 0.25 (fractions allowed): exported as
                                   # REXL3_MEMORY_FLOOR_GIB on every rank alike; empty: the engine default 8
EXTRA_FLAGS=                       # more rexl3-serve flags, appended on every rank alike (e.g. "--kv-tokens 4194304")
EXTRA_ENV=                         # more KEY=VALUE words in every rank's environment alike (no spaces inside a value)
DUMP_DIR=                          # absolute path on the nodes: sets REXL3_INKLING2_DUMP on every rank (oracle dumps;
                                   # start refuses a non-empty DUMP_DIR/rank<R>); bench/tools/merge_dump.py reads it
PROFILE_NSYS=                      # a lab profile, never a run's configuration: nsys profile arguments (e.g. "--delay=130
                                   # --duration=60 --trace=cuda,nvtx --sample=none --cpuctxsw=none"); every rank then runs under
                                   # `nsys profile` and writes BASE_DIR/prof/rank<R>.nsys-rep
READY_TIMEOUT_S=1800               # start: wait this long for /v1/models on rank 0 (each rank loads ~73 GiB)
STOP_GRACE_S=60                    # stop: SIGTERM, then SIGKILL after this many seconds
MIN_AVAIL_GIB=100                  # doctor/start: MemAvailable every node needs before a boot

# ── memory guard (per rank, scripts/memguard.sh, mandatory) ───────────────────────────────────────────────────────
# SIGKILLs its rank when MemAvailable stays under the floor for 3 samples (0.5 s apart) or swap grows past the cap,
# and records the MemAvailable minimum (BASE_DIR/logs/memguard-rank<R>.min; ./inkling2.sh memwatch begin|report).
GUARD_START_MIB=2048               # floor while the pack loads
GUARD_MIB=1024                     # floor once rank 0 answers /v1/models
GUARD_SWAP_MAX_MIB=64              # swap growth since the guard armed that kills the rank
GUARD_SWAP_AVAIL_MIB=8192            # ...counted only while MemAvailable is under this: the engine's 8 GiB floor. At 4 x 1M
                                     # lanes + prefix cache + drafter + vision a rank sits at ~10-12 GiB MemAvailable, and a
                                     # 16 GiB threshold killed rank 0 on benign swap growth at ready (record 2026-11-18-inkling2-final-base)
DROP_CACHES_EVERY_S=20             # page-cache drop while loading (sudo -n; 0 = never); GB10 counts only free memory

ALLOWED_CONTAINERS="mentatd glm53-nfs"
# The DeepSeek-V4.1 4x stack (spark-ds41f, container spark-ds41f) normally owns all four GPUs. Run from this machine.
STOP_OTHER="cd $HOME/recipes/spark-ds41f && TMPDIR=/tmp bin/spark --cluster-config config/cluster.json cluster stop --apply --parallel"
RESTORE_OTHER="cd $HOME/recipes/spark-ds41f && TMPDIR=/tmp bin/spark --cluster-config config/cluster.json cluster start --replace"
