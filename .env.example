# Inkling-2-Small-EXL3-4bpw-4x-DGX-Spark configuration. Copy to .env.
NODES="192.168.1.121 192.168.1.122 192.168.1.123 192.168.1.18"
FABRIC_ADDRS="10.100.10.1 10.100.10.2 10.100.10.3 10.100.10.4"   # rail-0 address per rank on the RoCE switch (fetch fan-out)
SSH_USER=spark
BASE_DIR=/home/spark/inkling-2-small-exl3-4bpw-4x-dgx-spark
MODELS_DIR=/home/spark/models
HF_BIN=/home/spark/venvs/hf/bin/hf
CACHE_DIR=/home/spark/.cache/inkling-2-small-exl3-4bpw-4x-dgx-spark
CONTAINER=inkling-2-small-exl3-4bpw-4x-dgx-spark
SERVED_NAME=inkling-2-small-exl3-4bpw-4x-dgx-spark
PORT=8000
API_KEY=
PROFILE=bootstrap
GUARD_START_MIB=2048
GUARD_MIB=1024
GUARD_SWAP_MAX_MIB=64
DROP_CACHES_EVERY_S=20
ALLOWED_CONTAINERS="mentatd glm53-nfs"
# The DeepSeek-V4.1 4x stack (spark-ds41f, container spark-ds41f) normally owns all four GPUs. Run from this machine.
STOP_OTHER="cd $HOME/recipes/spark-ds41f && TMPDIR=/tmp bin/spark --cluster-config config/cluster.json cluster stop --apply --parallel"
RESTORE_OTHER="cd $HOME/recipes/spark-ds41f && TMPDIR=/tmp bin/spark --cluster-config config/cluster.json cluster start --replace"
